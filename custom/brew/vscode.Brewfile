# VSCode extensions managed via Brewfile

# Themes
vscode "catppuccin.catppuccin-vsc"  # Catppuccin theme

# AI Assistants
vscode "anthropic.claude-code"      # AI coding assistant
vscode "github.copilot"             # GitHub Copilot
vscode "github.copilot-chat"        # GitHub Copilot Chat
vscode "openai.chatgpt"             # ChatGPT integration

# Language Support
vscode "tamasfe.even-better-toml"   # Enhanced TOML support
vscode "nefrob.vscode-just-syntax"  # Justfile syntax highlighting

# Utilities
vscode "naumovs.color-highlight"    # Color highlighter
